var cons = func(h, t) => func(w) => { if (w == 0) { h; } else { t; } };
var car = func(p) => p(0);
var cdr = func(p) => p(1);
var nil = 0;

var n = 1000;
var list = nil;
var i = 0;
while (i < n) {
	list = cons(i, list);
	i = i + 1;
}

var sum = 0;
var it = list;
while (it != 0) {
	sum = sum + car(it);
	it = cdr(it);
}
outn(sum);
